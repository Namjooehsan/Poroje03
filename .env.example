APP_SECRET=replace-with-long-random-secret
TELEGRAM_ADMIN_IDS=your_numeric_telegram_user_id
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-webhook-secret
BUFFER_API_KEY=
# Optional: leave empty to auto-select the first organization in your Buffer account.
BUFFER_ORGANIZATION_ID=
POST_TIMEZONE=Asia/Tehran
GLOBAL_PROVIDERS=facebook,instagram
IRAN_PROVIDERS=
# false = save drafts for review; true = schedule automatic publishing.
AUTO_PUBLISH=false
PORT=8000
DATABASE_PATH=/data/posts.db
LOG_LEVEL=INFO
